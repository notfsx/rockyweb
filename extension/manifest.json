{
  "manifest_version": 3,
  "name": "Rockyweb: Cookie Consent, Ad and Tracker Blocker",
  "short_name": "Rockyweb",
  "version": "1.1.1",
  "description": "Answers cookie popups with your choices, blocks ads and learns trackers, with per-site modes so websites keep working.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Rockyweb",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "alarms",
    "declarativeNetRequest",
    "scripting",
    "storage",
    "webRequest"
  ],
  "optional_permissions": [
    "background"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared/constants.js",
        "shared/domain.js",
        "shared/ai-policy.js",
        "shared/page-edits.js",
        "engines/consent-rules.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads",
        "enabled": true,
        "path": "rules/ads.json"
      },
      {
        "id": "trackers",
        "enabled": true,
        "path": "rules/trackers.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "surrogates/google-analytics.js",
        "surrogates/googletag-gpt.js",
        "surrogates/googletagmanager-gtm.js",
        "surrogates/adsbygoogle.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
