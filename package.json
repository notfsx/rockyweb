{
  "name": "rockyweb",
  "version": "1.1.1",
  "private": true,
  "description": "Rockyweb: a Manifest V3 extension that answers cookie banners, blocks ads and trackers, and makes reversible page changes with on-device AI.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:rules": "node scripts/build-rules.mjs",
    "build:icons": "node scripts/generate-icons.mjs",
    "build": "npm run build:rules && npm run build:icons",
    "verify": "node scripts/verify.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e/run-e2e.mjs && node tests/e2e/run-ai-e2e.mjs",
    "test:upgrade": "node tests/e2e/run-upgrade.mjs",
    "test:a11y": "node tests/e2e/run-a11y.mjs",
    "test:soak": "node tests/e2e/run-soak.mjs",
    "check": "npm run verify && npm test",
    "package": "node scripts/package.mjs",
    "store:assets": "node scripts/store-assets.mjs",
    "test:nano": "node tests/nano/run-real-nano.mjs",
    "perf": "node tests/perf/compare-modes.mjs",
    "test:sites": "node tests/sites/run-sites.mjs && node tests/sites/report.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.10.3",
    "playwright": "^1.65.1"
  }
}
